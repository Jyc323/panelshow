# Copy this file to .env and fill in your key. .env is ignored by git.
GMI_API_KEY=

# Optional settings (defaults shown)
# GMI_BASE_URL=https://api.gmi-serving.com/v1
# PORT=8790
# PANELSHOW_MAX_TOKENS=8000          # output limit per reply
# PANELSHOW_TIMEOUT_MS=300000        # per request; thinking models can be slow
# PANELSHOW_DIRECTOR_MODEL=          # model that plans Smart invite (default: newest GPT, Gemini Pro, Qwen Max or DeepSeek your key can call)
# PANELSHOW_AUTO_PROBE=1             # 0 skips the two tiny test calls when a model is first invited
# PANELSHOW_ALLOW_PRIVATE_URLS=0     # 1 lets members open localhost / LAN addresses
# PANELSHOW_DATA_DIR=./data          # where rooms are stored
